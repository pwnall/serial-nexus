#!/usr/bin/env bash
# Bless `serial-nexus-devprep` so the privileged replug tests can run (design §15.45).
#
# One command a developer types in a terminal:
#
#     scripts/bless              # debug   (what `cargo test` uses)
#     scripts/bless --release    # release
#     scripts/bless --all        # both
#     scripts/bless --verify     # report state, install nothing, ask for no password
#
# What it does per profile: build the helper, install a copy at
# `.snx-bin/<profile>/` with mode 0700, apply the helper's own required capability
# set (derived via `install --print-setcap`, never spelled here) with one
# `sudo setcap`, and verify the result. It is idempotent and **skips the sudo
# entirely** when the installed copy is already byte-identical to the build and
# already carries the capability — so re-running it costs nothing and prompts for
# nothing.
#
# Every run also leaves `.snx-bin/<profile>/` holding exactly one capability-carrying
# file: the copy that belongs there. The sweep lives in the helper's own `install`
# verb — it is derived from the capability set that verb already owns, rather than
# from a list spelled here — and it runs on `--verify` too, which is why even the
# already-blessed fast path below restores that invariant. A blessed binary nothing
# references is what §15.45's narrowness argument is about, and a rename left exactly
# one behind (notes §3.81).
#
# Why a sudo at all, and why only here: `authorized` under /sys is root-owned, so
# writing it needs CAP_DAC_OVERRIDE, and only root may grant a file capability.
# Nothing else in this repository asks for privilege, and the helper itself never
# invokes sudo — the privileged step is a command a human runs and can read first.
#
# No `-e`: each profile is attempted independently so one failure still reports the
# other, and the exit code is computed at the end.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
repo="$PWD"

profiles=()
verify_only=0
for arg in "$@"; do
  case "$arg" in
    --release) profiles+=("release") ;;
    --debug)   profiles+=("debug") ;;
    --all)     profiles+=("debug" "release") ;;
    --verify)  verify_only=1 ;;
    -h|--help)
      # The header block, **derived rather than a line range**. This was
      # `sed -n '2,28p'`, and a hand-kept range is a hand-kept list one dimension
      # over: the first paragraph added to the header above truncated `--help`
      # mid-sentence and nothing said so (measured — the 2026-08-12 sweep paragraph
      # did exactly that). Print every comment line after the shebang and stop at
      # the first line that is not one.
      awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
      exit 0
      ;;
    *)
      echo "bless: unknown argument '$arg' (try --help)" >&2
      exit 2
      ;;
  esac
done
[ ${#profiles[@]} -eq 0 ] && profiles=("debug")

# `sudo` needs a terminal to prompt. In a GUI session without one — an editor's
# embedded shell, an agent harness — `pkexec` asks through the polkit agent
# instead. Prefer sudo when it can actually prompt, because it is what the tool's
# own message tells you to run.
run_privileged() {
  if sudo -n true 2>/dev/null; then
    sudo "$@"
  elif [ -t 0 ] && [ -t 1 ]; then
    sudo "$@"
  elif command -v pkexec >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    echo "bless: no terminal for sudo to prompt on; asking through pkexec" >&2
    pkexec "$@"
  else
    echo "bless: this step needs root and there is no way to prompt here." >&2
    echo "bless: run it yourself in a terminal:" >&2
    echo "    sudo $*" >&2
    return 1
  fi
}

rc=0
for profile in "${profiles[@]}"; do
  echo "== ${profile} =="
  built="$repo/target/$profile/serial-nexus-devprep"
  # There is deliberately no `blessed=` path here. One stood at this line from
  # `adec786` until plan §18 item 110 and was never expanded: it died when the script
  # stopped inspecting `.snx-bin/` itself and started asking the tool (the design this
  # file's header states below — "ask the tool"), because `install --verify` owns the
  # comparison and spells the installed path from the capability set it already knows.
  # Spelling it a second time here would be the two-copies-that-must-agree shape §16.5
  # bans, one file over.

  # **`--verify` builds too, and skipping it was a defect** (plan §18 item 101).
  # `install --verify` compares the installed copy against
  # `target/<profile>/serial-nexus-devprep`, and that path is a *hardlink* cargo
  # re-points at whichever `deps/` artifact matches the last invocation's unit
  # graph. A workspace-scoped build — which is every gate in AGENTS §3 — unifies
  # features across the members (measured: `nix` gains `feature` and `user`,
  # `memchr` gains `default`, `serde_core` gains `alloc` and `result`), so it
  # produces a *different* devprep binary and re-points the link at it. `--verify`
  # then read `Stale` on a correctly blessed tree. Building here costs a cached
  # 0.03s, touches no installed copy and asks for no password; what it buys is that
  # the artifact being compared against is the one this script would install, which
  # is the only thing the comparison ever meant.
  flags=(--locked -p serial-nexus-devprep)
  [ "$profile" = "release" ] && flags+=(--release)
  if ! cargo build "${flags[@]}"; then
    echo "bless: ${profile}: build failed" >&2
    rc=1
    continue
  fi

  if [ ! -x "$built" ]; then
    echo "bless: ${profile}: $built is missing — build it first" >&2
    rc=1
    continue
  fi

  # Ask the tool, not the filesystem: `install --verify` compares the installed
  # copy byte-for-byte against the build and re-reads mode and capability, so
  # "already blessed" is a measurement rather than the presence of a stamp file.
  #
  # **stdout is discarded and stderr is not**, deliberately. The `ready (…)` line is
  # noise on a path whose whole message is "nothing to do"; the orphan sweep's report
  # is on stderr precisely so that a removed capability-carrying file is announced
  # even here, where nothing else runs. Discarding both — which this line did until
  # 2026-08-12 — would make the one path most likely to *find* an orphan the one path
  # that could not tell you about it.
  if "$built" install --profile "$profile" --verify >/dev/null; then
    echo "bless: ${profile}: already blessed (build unchanged, mode 0700, +ep) — nothing to do"
    continue
  fi

  if [ "$verify_only" -eq 1 ]; then
    "$built" install --profile "$profile" --verify
    rc=1
    continue
  fi

  # Copy + chmod 0700. Unprivileged, and it strips any previous capability,
  # which is the kernel's doing and is the point: a rewritten binary is never
  # silently still blessed.
  # Exit 2 here is BLOCKED-ON-BLESS and is the *expected* outcome: the copy
  # landed and the capability is not on it yet, which is precisely what the next
  # line fixes. Only a genuine failure (3, 70) means the copy did not happen.
  "$built" install --profile "$profile" >/dev/null
  case $? in
    0 | 2) ;;
    *)
      echo "bless: ${profile}: install failed" >&2
      rc=1
      continue
      ;;
  esac

  # **Show it, then run it.** The command was previously printed only when there
  # was no way to prompt for root — so on a box where sudo *could* prompt, the one
  # privileged step this script takes happened without ever being displayed. An
  # operator should see the exact capability grant they are being asked to approve
  # before the password prompt, not instead of it (notes §3.79).
  #
  # The capability list comes from the binary (`install` prints the command it will
  # verify against), so the string shown, the string run, and the string `--verify`
  # checks can never drift apart.
  setcap_cmd=$("$built" install --profile "$profile" --print-setcap 2>/dev/null || true)
  if [ -z "$setcap_cmd" ]; then
    echo "bless: ${profile}: could not read the setcap command from the helper" >&2
    rc=1
    continue
  fi
  echo "bless: ${profile}: granting the capability it needs, as root:"
  echo "    $setcap_cmd"
  # `$setcap_cmd` is `sudo setcap <caps>+ep <path>`; run_privileged supplies the
  # privilege itself, so strip the leading `sudo` and pass the rest as arguments.
  # shellcheck disable=SC2086
  set -- $setcap_cmd
  shift # drop `sudo`
  if ! run_privileged "$@"; then
    rc=1
    continue
  fi

  if "$built" install --profile "$profile" --verify; then
    echo "bless: ${profile}: ready"
  else
    echo "bless: ${profile}: still not blessed after setcap" >&2
    rc=1
  fi
done

if [ "$rc" -eq 0 ]; then
  echo
  echo "Run the privileged tests with:"
  echo "    SNX_REPLUG=required SNX_REPLUG_DEV=/dev/serial/by-id/<adapter-a> \\"
  echo "        SNX_REPLUG_DEV_B=/dev/serial/by-id/<adapter-b> \\"
  echo "        cargo test -p serial-nexus-itest --test p7_replug_hardware"
  echo
  echo "Both adapters are named on purpose: the renumbering test needs two to force a"
  echo "swap, and under SNX_REPLUG=required its self-skip is a hard failure, not a skip."
fi
exit "$rc"
