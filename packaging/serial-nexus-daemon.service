# serial-nexus-daemon — systemd service unit (serial_nexus, design §10/§11/§13).
#
# Install to /etc/systemd/system/serial-nexus-daemon.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now serial-nexus-daemon
# See packaging/README.md for the full setup (user, groups, device access).
#
# The daemon opens its OWN control socket (no socket activation — that is §14
# out-of-scope), loads its configuration on start, and shuts down cleanly on
# SIGTERM/SIGINT (releases PTY symlinks and serial ports, removes the socket).

[Unit]
Description=serial_nexus daemon (serial ports as a routing graph)
Documentation=https://github.com/pwnall/serial-nexus
After=network.target

[Service]
Type=exec
ExecStart=/usr/local/bin/serial-nexus-daemon \
    --socket /run/serial-nexus-daemon/serial-nexus-daemon.sock \
    --state-file /var/lib/serial-nexus-daemon/state.toml \
    --config /etc/serial-nexus-daemon/config.toml
# The daemon prefers the persisted state file over --config when it exists (§11):
# --config is the first-boot seed; incremental surgery (add-node/remove-node/rotate)
# is captured in the state file and survives restarts and reboots.
#
# UPGRADING from a pre-rename release: the daemon adopts a snapshot found at this path
# with §15.40's rename undone (plan §17.3), so a deployment that passes --state-file
# needs no migration. This unit is the one exception, and it is systemd's doing rather
# than the daemon's: DynamicUser= puts the real state directory under /var/lib/private/,
# which is root-only, so the daemon cannot read the old file even knowing where it is.
# One root `cp` before the first start carries it across — packaging/README.md,
# "Upgrading to this build". Skipping it costs every node added since the last `load`.

# --- Identity ------------------------------------------------------------------
# A transient, unprivileged service identity. It still needs the `dialout` group to
# open USB serial device nodes (/dev/ttyUSB*, /dev/ttyACM* are root:dialout 0660).
# If your distro uses `uucp` instead, change it here.
DynamicUser=yes
SupplementaryGroups=dialout

# --- Runtime, state & log directories (systemd creates AND chowns these) -------
# These *Directory= families are created and chowned to the (transient) service
# identity on every start — which is exactly why a log node must use LogsDirectory
# and not a bare ReadWritePaths (the latter flips the mount to read-write but does
# NOT chown, so a root-owned dir stays unwritable to a DynamicUser; see below).
#
# /run/serial-nexus-daemon holds the control socket (cleared on stop; §10 socket policy).
# 0700 makes it owner-exclusive, bounding the brief post-bind window before the
# daemon narrows the socket itself to 0600 (§10). Widening the socket to a group with
# --socket-group means widening this too — and changing WHO owns it, which is not a
# mode change at all; see the socket-group block below before touching either.
RuntimeDirectory=serial-nexus-daemon
RuntimeDirectoryMode=0700
# /var/lib/serial-nexus-daemon holds the config snapshot so surgery survives a REBOOT (the
# socket-adjacent default under /run is wiped on reboot; §11/§15.9).
StateDirectory=serial-nexus-daemon
StateDirectoryMode=0700
# /var/log/serial-nexus-daemon is where the example config's log node writes; LogsDirectory
# creates and chowns it to the service so the log writer can create/rotate files (§7.3).
LogsDirectory=serial-nexus-daemon
LogsDirectoryMode=0750

# The control socket's file permissions ARE the authorization model (§10): 0600
# owner-only by default. Letting a `console-operators` group drive the daemon needs the
# RUNTIME DIRECTORY to belong to that group as well, and that is the part a
# SupplementaryGroups= line cannot buy: systemd chowns every *Directory= to User= and
# Group=, full stop — systemd.exec(5), "the innermost specified directories will be
# owned by the user and group specified in User= and Group=". Under DynamicUser= those
# are the transient identity, so a 0750 /run/serial-nexus-daemon leaves the operators in
# `other` and they get EACCES at connect(2) before the socket's own 0660 is ever
# consulted. The group therefore has to be the service's PRIMARY group, which means a
# static identity. Create it once:
#   sudo groupadd --system console-operators
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin \
#        --gid console-operators --groups dialout serial-nexus
# then replace the DynamicUser= block above with the static one, and widen both:
#   DynamicUser=no
#   User=serial-nexus
#   Group=console-operators
#   SupplementaryGroups=dialout
#   RuntimeDirectoryMode=0750
#   ExecStart= ... --socket-group console-operators
#
# Verify rather than assume — the failure mode is silent, and one stat covers the whole
# chain (traverse the directory, then open the socket):
#   stat -c '%U %G %a' /run/serial-nexus-daemon \
#        /run/serial-nexus-daemon/serial-nexus-daemon.sock
#   # serial-nexus console-operators 750
#   # serial-nexus console-operators 660
#
# Two consequences of the static identity, both deliberate. The state and log
# directories lose systemd's /var/lib/private and /var/log/private indirection (that is
# a DynamicUser= behaviour), so an existing install's snapshot has to be moved with it.
# And LogsDirectoryMode=0750 now makes console logs readable by console-operators — the
# same people who can already read every console live through the socket. Read
# ../docs/security.md first: serial consoles are frequently root shells.

# --- Lifecycle -----------------------------------------------------------------
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

# --- Sandboxing (systemd hardening) --------------------------------------------
# Tightened as far as a daemon that needs raw character devices can go. The two
# deliberate loosenings are called out: it MUST reach serial device nodes and the
# pty subsystem, so PrivateDevices stays off and /dev access is scoped explicitly.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX for the control socket; AF_INET/AF_INET6 only if you configure a leg node
# (loopback-only by default, §7.4/§9). Drop the INET families if you use no legs.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Device access: the daemon needs USB serial nodes and the pty master/slave devices.
# PrivateDevices=yes would HIDE /dev/ttyUSB*, so it is left off and /dev is scoped.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
# If your adapters enumerate under a different major (e.g. FTDI cdc-acm, or a
# platform UART like /dev/ttyS* or /dev/ttyAMA*), add the matching DeviceAllow line.

# The default log directory is handled by LogsDirectory= above (created and chowned
# to the service). ProtectSystem=strict makes the rest of the filesystem read-only,
# so for any EXTRA log-node directory OUTSIDE /var/log/serial-nexus-daemon, add it here —
# and, under DynamicUser, pre-chown it to the service (a plain root-owned
# ReadWritePaths dir is NOT writable: ReadWritePaths flips the mount but does not
# chown). Prefer a subdirectory of the LogsDirectory to avoid this entirely.
# ReadWritePaths=/srv/console-logs   # example: an extra, pre-chowned log directory

[Install]
WantedBy=multi-user.target
